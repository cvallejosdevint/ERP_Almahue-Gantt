TLDV_API_KEY=

# Trello (el token tiene que incluir scope write, no solo read)
TRELLO_API_KEY=
TRELLO_TOKEN=
# Autorizar: https://trello.com/1/authorize?expiration=never&name=Almahue%20tools&scope=read,write&response_type=token&key=TU_API_KEY
