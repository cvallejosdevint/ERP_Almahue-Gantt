{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Almahue: stack local",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/scripts/start-local-stack.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
