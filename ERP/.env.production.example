# Plantilla de producción / servidor compartido (sin secretos reales).
# Copiar a .env en el host de deploy y completar valores.

# Usar con: docker compose -f docker-compose.prod.yml --env-file .env up -d
# Stack independiente (api + web + postgres propios). Ver DEPLOY.md / SERVER.md en el host.

COMPOSE_PROJECT_NAME=almahue_erp

ERP_API_IMAGE=almahue-erp-api:prod
ERP_WEB_IMAGE=almahue-erp-web:prod

# Host binds (solo localhost; nginx del host hace TLS/proxy)
ERP_API_HOST_PORT=4010
ERP_API_PORT_INTERNAL=3001
ERP_WEB_HOST_PORT=4011

POSTGRES_USER=erp
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=erp

# Host interno Docker = nombre del contenedor postgres
DATABASE_URL=postgresql://erp:REPLACE_WITH_STRONG_PASSWORD@almahue_erp_postgres:5432/erp?schema=erp

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h

# Acceso por IP (sin DNS): http://45.7.229.46/almahue-erp/
FRONTEND_URL=http://45.7.229.46/almahue-erp
CORS_ORIGINS=http://45.7.229.46,http://45.7.229.46/almahue-erp,http://127.0.0.1:4011

PASSWORD_RESET_DEV_RETURN_LINK=false
# Stack propio vacío: migrate al boot OK
RUN_MIGRATE=true

# Subpath en el default_server (nginx host strip → contenedores)
VITE_BASE_PATH=/almahue-erp/
VITE_API_URL=/almahue-erp/api/v1
VITE_APP_TITLE=Almahue ERP
