# Copiar a .env y ajustar. No commitear secretos reales.
# Uso local / laboratorio con compose.

COMPOSE_PROJECT_NAME=almahue-erp

# --- Contenedores / red / puertos (portables para host compartido) ---
ERP_API_CONTAINER=almahue-erp-api
ERP_WEB_CONTAINER=almahue-erp-web
ERP_DB_CONTAINER=almahue-erp-db
ERP_NETWORK_NAME=almahue-erp
ERP_API_HOST_PORT=3001
ERP_API_PORT_INTERNAL=3001
ERP_WEB_HOST_PORT=8080
ERP_DB_HOST_PORT=5433

ERP_API_IMAGE=almahue-erp-api:local
ERP_WEB_IMAGE=almahue-erp-web:local

# --- API ---
# Prisma usa schema PostgreSQL `erp` (ver erp_back/prisma/schema.prisma).
# En BD compartida: crear schema si no existe → CREATE SCHEMA IF NOT EXISTS erp;
# Y apuntar a host/puerto/db existentes (no hace falta el servicio `db` del compose).
DATABASE_URL=postgresql://almahue:almahue@host.docker.internal:5433/almahue?schema=erp

JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=8h

# Origen del front visto por el navegador (CORS)
FRONTEND_URL=http://localhost:8080
# Orígenes extra separados por coma (opcional)
CORS_ORIGINS=

PASSWORD_RESET_DEV_RETURN_LINK=false
# true = migrate deploy al arrancar el contenedor api (usar con cuidado en BD compartida)
RUN_MIGRATE=false

# --- Front (bake en imagen; rebuild si cambias) ---
# Mismo origen vía nginx del contenedor web → /api → api:3001
# Subpath en IP (prod): VITE_BASE_PATH=/almahue-erp/ y VITE_API_URL=/almahue-erp/api/v1
VITE_BASE_PATH=/
VITE_API_URL=/api/v1
VITE_APP_TITLE=Almahue ERP v1

# --- Banco Central (indicadores / tipo de cambio) ---
# Token REST BDE. En este .env de docker-compose cada `$` del token va duplicado ($$2a$$10$$...).
BC_BDE_TOKEN=
BC_CRON_ENABLED=false

# --- Billing gateway / DTE ---
# ENABLED=false: no emite DTE ni llama HTTP; comercial contabiliza sin partner (comportamiento histórico).
# ENABLED=true + STUB_INLINE=true: stub local ERP para demo, sin levantar billing-gateway.
# ENABLED=true + STUB_INLINE=false: HTTP a billing-gateway (:3040); el gateway elige stub vs GoSocket según registry.
BILLING_GATEWAY_ENABLED=false
BILLING_STUB_INLINE=true
BILLING_GATEWAY_URL=http://127.0.0.1:3040
BILLING_GATEWAY_API_KEY=almahue-demo-key

# --- Solo profile `db` (Postgres local opcional) ---
POSTGRES_USER=almahue
POSTGRES_PASSWORD=almahue
POSTGRES_DB=almahue
ERP_DB_VOLUME=almahue-erp-pgdata
