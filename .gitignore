__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Nested app repos (viven como git independientes)
ERP/erp_back/
ERP/erp_front/

# Dumps BD locales (solo versionar README + restore script)
ERP/backups/*.dump
ERP/backups/*.sql
ERP/backups/*.backup

# Videos de reuniones (pesados; viven en disco local)
docs/erp-planificacion/agrosoft-levantamiento/fuentes/videos/*.mp4

# Credenciales Trello (locales; no versionar)
docs/erp-planificacion/agrosoft-levantamiento/.env.trello

# Dependencias locales de scripts de captura Playwright
docs/erp-planificacion/agrosoft-levantamiento/node_modules/

# QA temporal / Playwright local
ERP/.qa-tmp/
ERP/qa-tmp/
ERP/qa-reu4-*/session-*.json
ERP/qa-reu4-*/qa-sessions.json

# Informes de corrida QA (solo local; en git: README + PLANTILLA)
docs/erp-planificacion/agrosoft-levantamiento/qa/resultados/*
!docs/erp-planificacion/agrosoft-levantamiento/qa/resultados/README.md
!docs/erp-planificacion/agrosoft-levantamiento/qa/resultados/PLANTILLA.md

# Dumps QA con tokens (nunca versionar)
